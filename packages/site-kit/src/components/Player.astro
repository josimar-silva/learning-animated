---
interface Props {
  loop: number | null;
}
const { loop } = Astro.props;
const button =
  'inline-flex h-9 items-center rounded-md border border-border px-3 text-sm font-medium text-foreground hover:bg-accent';
---

<div data-role="controls" class="mt-3 flex flex-wrap items-center gap-2">
  <button type="button" class={button} data-action="toggle" aria-pressed="false">
    Pause
  </button>
  <button type="button" class={button} data-action="restart">
    Restart
  </button>
  {loop !== null && (
    <label class="flex flex-1 items-center gap-2 text-sm text-muted-foreground">
      <span class="sr-only">Scrub through the animation</span>
      <input
        type="range"
        data-role="scrubber"
        min="0"
        max={loop}
        step="0.1"
        value="0"
        class="w-full"
      />
    </label>
  )}
  <p class="w-full text-xs text-muted-foreground pointer-coarse:hidden">
    Space pauses, R restarts, arrows move between animations
  </p>
</div>
