---
import { absoluteUrl } from '../routes.ts';

interface Props {
  siteUrl: string;
  title: string;
  views: ReadonlyArray<{ label: string | null; src: string }>;
}
const { siteUrl, title, views } = Astro.props;
---

<section data-role="embed" class="mt-8">
  <h2 class="text-lg font-semibold">Embed this animation</h2>
  {views.map((view) => {
    const url = absoluteUrl(siteUrl, view.src);
    const name = view.label ? `${title} (${view.label})` : title;
    return (
      <div class="mt-3">
        {view.label && <p class="text-sm font-medium">{view.label}</p>}
        {/* prettier-ignore */}
        <pre class="overflow-x-auto rounded-md bg-muted p-3 text-xs"><code>{`![${name}](${url})`}</code></pre>
        {/* prettier-ignore */}
        <pre class="mt-2 overflow-x-auto rounded-md bg-muted p-3 text-xs"><code>{`<img src="${url}" alt="${name}">`}</code></pre>
        <a href={view.src} download class="mt-2 inline-block text-sm">
          Download the SVG
        </a>
      </div>
    );
  })}
</section>
